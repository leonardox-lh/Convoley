# Copy to .env.local. Local values match docker-compose.yml.
DATABASE_URL="postgresql://convoley:convoley@localhost:5433/convoley"
# Separate database for `npm run test:integration` (wiped on every run; name must end in _test).
TEST_DATABASE_URL="postgresql://convoley:convoley@localhost:5433/convoley_test"
# Public URL used in email links (required in production, e.g. https://app-production-2fba69d8.up.railway.app).
APP_URL=""
# Auth.js. Generate the secret with `npx auth secret`.
AUTH_SECRET=""
# Google OAuth (optional locally: without them the Google button is hidden). Required in production.
AUTH_GOOGLE_ID=""
AUTH_GOOGLE_SECRET=""
# Resend, for the password-reset email (optional locally: the link is printed in the server console). Required in production.
RESEND_API_KEY=""
EMAIL_FROM=""
# Railway runs behind a proxy: set AUTH_TRUST_HOST=true there.
# In production APP_URL, AUTH_*, RESEND_API_KEY and EMAIL_FROM must also exist at build time (src/lib/env.ts checks them).
