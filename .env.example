# Copy to .env.local. Local values match docker-compose.yml.
DATABASE_URL="postgresql://convoley:convoley@localhost:5433/convoley"
# Separate database for `npm run test:integration` (wiped on every run; name must end in _test).
TEST_DATABASE_URL="postgresql://convoley:convoley@localhost:5433/convoley_test"
# Public URL used in email links (required in production, e.g. https://app-production-2fba69d8.up.railway.app).
APP_URL=""
# Auth.js. Generate the secret with `npx auth secret`.
AUTH_SECRET=""
# Google OAuth (optional locally: without them the Google button is hidden). Required in production.
AUTH_GOOGLE_ID=""
AUTH_GOOGLE_SECRET=""
# Resend, for the password-reset email (optional locally: the link is printed in the server console). Required in production.
RESEND_API_KEY=""
EMAIL_FROM=""
# S3-compatible bucket for club logos. Locally: the S3Mock from docker-compose.yml.
# On Railway, reference the bucket's variables: BUCKET, ENDPOINT, REGION, ACCESS_KEY_ID and SECRET_ACCESS_KEY.
BUCKET_NAME="convoley-dev"
BUCKET_ENDPOINT="http://localhost:9000"
BUCKET_REGION="us-east-1"
BUCKET_ACCESS_KEY_ID="local"
BUCKET_SECRET_ACCESS_KEY="local"
# Mercado Pago (optional locally: without them players pay by voucher). Steps in docs/sprints/sprint-3.md.
# Test credentials only in development; never commit real values.
MP_CLIENT_ID=""
MP_CLIENT_SECRET=""
MP_WEBHOOK_SECRET=""
# 32 random bytes in base64: `openssl rand -base64 32`.
MP_TOKEN_ENCRYPTION_KEY=""
# Railway runs behind a proxy: set AUTH_TRUST_HOST=true there.
# In production APP_URL, AUTH_*, RESEND_API_KEY, EMAIL_FROM, BUCKET_* and MP_* must also exist at build time (src/lib/env.ts checks them).
