// Initial data model (HT-03). Documented in docs/MODELO_DATOS.md.
// Conventions: money as Int cents (`*Cents`), DateTime in UTC, phones normalized
// to +519XXXXXXXX, files stored only as bucket keys (`*Key`), never public URLs.
// Each section names the module that owns its tables.

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum ClubRole {
  admin
  helper
}

enum EventStatus {
  draft
  published
  full
  closed
  cancelled
}

enum RegistrationStatus {
  pending_payment
  in_review
  paid
  // No seat yet (HU-12): first in line moves to pending_payment when a seat frees up.
  waitlisted
  cancelled
}

// Optional on sign-up (HU-10), used later to balance teams (HU-31).
enum PlayerPosition {
  setter
  libero
  outside_hitter
  middle_blocker
  opposite
  any
}

enum PlayerLevel {
  beginner
  intermediate
  advanced
}

enum PaymentMethod {
  mercado_pago
  voucher
  manual
}

enum PaymentStatus {
  pending
  in_review
  approved
  rejected
  // Mercado Pago (HU-20): approved but the seat was gone; the money goes back automatically.
  refund_pending
  refunded
}

// What happens with a payment when its event is cancelled (HU-05). Only a mark:
// the organizer moves the money in Mercado Pago, Convoley never holds it.
enum CancellationOutcome {
  refund
  balance
}

enum OrderStatus {
  pending_payment
  in_review
  paid
  delivered
  cancelled
}

// ─── identity (Auth.js Prisma adapter tables) ──────────────────────────────

model User {
  id            String    @id @default(cuid())
  name          String?
  email         String?   @unique
  emailVerified DateTime?
  image         String?
  // From the Google profile (HU-48): autocompletes the player's registrations.
  firstName     String?
  lastName      String?
  // Only organizers who sign up with email + password have one.
  passwordHash  String?
  // Links guest registrations to the account later (HU-48).
  phone         String?   @unique
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  accounts            Account[]
  sessions            Session[]
  passwordResetTokens PasswordResetToken[]
  memberships         ClubMember[]
  registrations       Registration[]
  orders              Order[]
  reviewedPayments    Payment[]            @relation("PaymentReviewer")
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String?
  access_token      String?
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String?
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
  @@index([userId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model VerificationToken {
  identifier String
  token      String
  expires    DateTime

  @@unique([identifier, token])
}

// ─── clubs ─────────────────────────────────────────────────────────────────

model Club {
  id                   String   @id @default(cuid())
  slug                 String   @unique
  name                 String
  description          String?
  logoKey              String?
  primaryColor         String?
  secondaryColor       String?
  instagramUrl         String?
  tiktokUrl            String?
  // Where players pay the organizer directly (HU-13): Yape/Plin number, holder and QR image.
  paymentPhone         String?
  paymentHolderName    String?
  paymentQrKey         String?
  // HU-22: optional fee the player pays on Mercado Pago charges; at most one of the two is set.
  serviceFeeFixedCents Int      @default(0)
  serviceFeePercentBps Int      @default(0)
  createdAt            DateTime @default(now())
  updatedAt            DateTime @updatedAt

  members     ClubMember[]
  communities Community[]
  events      Event[]
  payments    Payment[]
  products    Product[]
  orders      Order[]

  mercadoPagoConnection MercadoPagoConnection?
}

// Single-use link to set a new password (HU-01). Only the sha256 of the token is stored.
model PasswordResetToken {
  id        String    @id @default(cuid())
  userId    String
  tokenHash String    @unique
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model ClubMember {
  id        String   @id @default(cuid())
  clubId    String
  userId    String
  role      ClubRole
  createdAt DateTime @default(now())

  club Club @relation(fields: [clubId], references: [id], onDelete: Cascade)
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([clubId, userId])
  @@index([userId])
}

model Community {
  id        String   @id @default(cuid())
  clubId    String
  name      String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  club   Club    @relation(fields: [clubId], references: [id], onDelete: Cascade)
  events Event[]

  @@unique([clubId, name])
}

// ─── events ────────────────────────────────────────────────────────────────

model Event {
  id                  String               @id @default(cuid())
  // Duplicated from the community so `events` can filter by club on its own.
  clubId              String
  communityId         String
  title               String
  startsAt            DateTime
  venueName           String
  mapsUrl             String?
  priceCents          Int
  capacity            Int
  isMixed             Boolean              @default(false)
  rules               String?
  status              EventStatus          @default(draft)
  cancelledAt         DateTime?
  // Chosen by the organizer on cancel; tells registered players what happens to their money.
  cancellationOutcome CancellationOutcome?
  createdAt           DateTime             @default(now())
  updatedAt           DateTime             @updatedAt

  club          Club           @relation(fields: [clubId], references: [id], onDelete: Restrict)
  community     Community      @relation(fields: [communityId], references: [id], onDelete: Restrict)
  registrations Registration[]
  pickupOrders  Order[]

  @@index([clubId, startsAt])
  @@index([communityId])
}

// ─── registrations ─────────────────────────────────────────────────────────

// A guest registration is simply one with userId = null.
model Registration {
  id            String             @id @default(cuid())
  eventId       String
  userId        String?
  firstName     String
  lastName      String
  phone         String
  position      PlayerPosition?
  level         PlayerLevel?
  status        RegistrationStatus @default(pending_payment)
  // HU-21: while paying with Mercado Pago the seat is held only until this moment.
  reservedUntil DateTime?
  createdAt     DateTime           @default(now())
  updatedAt     DateTime           @updatedAt

  event    Event     @relation(fields: [eventId], references: [id], onDelete: Restrict)
  user     User?     @relation(fields: [userId], references: [id], onDelete: SetNull)
  payments Payment[]

  // Database-level guard against double registration, even under concurrency.
  @@unique([eventId, phone])
  @@index([eventId, createdAt])
  @@index([phone])
  @@index([userId])
}

// ─── payments ──────────────────────────────────────────────────────────────

// One row per attempt; exactly one of registrationId / orderId is set (SQL CHECK).
model Payment {
  id                   String               @id @default(cuid())
  clubId               String
  registrationId       String?
  orderId              String?
  // Total charged, service fee included (HU-22).
  amountCents          Int
  serviceFeeCents      Int                  @default(0)
  method               PaymentMethod
  status               PaymentStatus        @default(pending)
  // Mercado Pago payment id: makes the webhook idempotent.
  providerPaymentId    String?              @unique
  // Private voucher image: bucket key, read only through signed URLs.
  proofFileKey         String?
  yapeSecurityCode     String?
  rejectionReason      String?
  // Mercado Pago's status_detail (cc_rejected_insufficient_amount…), to explain a failure.
  providerStatusDetail String?
  // Set when the event is cancelled (HU-05); a mark only, no money moves through Convoley.
  cancellationOutcome  CancellationOutcome?
  reviewedAt           DateTime?
  reviewedByUserId     String?
  createdAt            DateTime             @default(now())
  updatedAt            DateTime             @updatedAt

  club         Club          @relation(fields: [clubId], references: [id], onDelete: Restrict)
  registration Registration? @relation(fields: [registrationId], references: [id], onDelete: Restrict)
  order        Order?        @relation(fields: [orderId], references: [id], onDelete: Restrict)
  reviewedBy   User?         @relation("PaymentReviewer", fields: [reviewedByUserId], references: [id], onDelete: SetNull)

  @@index([registrationId])
  @@index([orderId])
  @@index([clubId, createdAt])
}

// The organizer's Mercado Pago account, connected by OAuth (HU-18). Players' payments are
// created with this token, so the money goes straight to the organizer: Convoley holds none.
model MercadoPagoConnection {
  id                    String   @id @default(cuid())
  clubId                String   @unique
  mpUserId              String   @unique
  // AES-256-GCM with MP_TOKEN_ENCRYPTION_KEY; never stored in plain text.
  accessTokenEncrypted  String
  refreshTokenEncrypted String
  // Not secret: the browser SDK needs it to tokenize cards and Yape.
  publicKey             String
  expiresAt             DateTime
  liveMode              Boolean
  connectedByUserId     String
  createdAt             DateTime @default(now())
  updatedAt             DateTime @updatedAt

  club Club @relation(fields: [clubId], references: [id], onDelete: Cascade)
}

// ─── store ─────────────────────────────────────────────────────────────────

model Product {
  id          String   @id @default(cuid())
  clubId      String
  name        String
  description String?
  priceCents  Int
  // Up to 5 bucket keys; the limit is a domain rule.
  imageKeys   String[]
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  club     Club             @relation(fields: [clubId], references: [id], onDelete: Restrict)
  variants ProductVariant[]

  @@index([clubId])
}

model ProductVariant {
  id        String  @id @default(cuid())
  productId String
  // null when the product has no sizes.
  size      String?
  stock     Int

  product    Product     @relation(fields: [productId], references: [id], onDelete: Cascade)
  orderItems OrderItem[]

  @@unique([productId, size])
}

model Order {
  id            String      @id @default(cuid())
  clubId        String
  userId        String?
  firstName     String
  lastName      String
  phone         String
  pickupEventId String
  status        OrderStatus @default(pending_payment)
  totalCents    Int
  createdAt     DateTime    @default(now())
  updatedAt     DateTime    @updatedAt

  club        Club        @relation(fields: [clubId], references: [id], onDelete: Restrict)
  user        User?       @relation(fields: [userId], references: [id], onDelete: SetNull)
  pickupEvent Event       @relation(fields: [pickupEventId], references: [id], onDelete: Restrict)
  items       OrderItem[]
  payments    Payment[]

  @@index([clubId, status])
  @@index([userId])
  @@index([pickupEventId])
}

model OrderItem {
  id             String @id @default(cuid())
  orderId        String
  variantId      String
  quantity       Int
  // Price frozen at purchase time.
  unitPriceCents Int

  order   Order          @relation(fields: [orderId], references: [id], onDelete: Cascade)
  variant ProductVariant @relation(fields: [variantId], references: [id], onDelete: Restrict)

  @@index([orderId])
  @@index([variantId])
}
