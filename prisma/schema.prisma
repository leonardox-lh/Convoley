// Initial data model (HT-03). Documented in docs/MODELO_DATOS.md.
// Conventions: money as Int cents (`*Cents`), DateTime in UTC, phones normalized
// to +519XXXXXXXX, files stored only as bucket keys (`*Key`), never public URLs.
// Each section names the module that owns its tables.

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum ClubRole {
  admin
  helper
}

enum EventStatus {
  draft
  published
  full
  closed
  cancelled
}

enum RegistrationStatus {
  pending_payment
  in_review
  paid
  // No seat yet (HU-12): first in line moves to pending_payment when a seat frees up.
  waitlisted
  cancelled
}

// Optional on sign-up (HU-10), used later to balance teams (HU-31).
enum PlayerPosition {
  setter
  libero
  outside_hitter
  middle_blocker
  opposite
  any
}

// HU-31: asked only in mixed events, to respect the minimum of women per team.
enum PlayerGender {
  female
  male
}

enum PlayerLevel {
  beginner
  intermediate
  advanced
}

enum PaymentMethod {
  mercado_pago
  voucher
  manual
}

enum PaymentStatus {
  pending
  in_review
  approved
  rejected
  // Mercado Pago (HU-20): approved but the seat was gone; the money goes back automatically.
  refund_pending
  refunded
}

// What happens with a payment when its event is cancelled (HU-05). Only a mark:
// the organizer moves the money in Mercado Pago, Convoley never holds it.
enum CancellationOutcome {
  refund
  balance
}

// HU-27: a plan bought by a player; credits are usable only once it's active (paid).
enum PlanPurchaseStatus {
  pending_payment
  in_review
  active
}

enum OrderStatus {
  pending_payment
  in_review
  paid
  delivered
  cancelled
}

// ─── identity (Auth.js Prisma adapter tables) ──────────────────────────────

model User {
  id            String    @id @default(cuid())
  name          String?
  email         String?   @unique
  emailVerified DateTime?
  image         String?
  // From the Google profile (HU-48): autocompletes the player's registrations.
  firstName     String?
  lastName      String?
  // Only organizers who sign up with email + password have one.
  passwordHash  String?
  // Links guest registrations to the account later (HU-48).
  phone         String?   @unique
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  accounts                     Account[]
  sessions                     Session[]
  passwordResetTokens          PasswordResetToken[]
  memberships                  ClubMember[]
  sentInvitations              ClubInvitation[]
  registrations                Registration[]
  orders                       Order[]
  planPurchases                PlanPurchase[]
  balances                     PlayerBalance[]
  reviewedPayments             Payment[]             @relation("PaymentReviewer")
  recordedSubscriptionPayments SubscriptionPayment[]
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String?
  access_token      String?
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String?
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
  @@index([userId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model VerificationToken {
  identifier String
  token      String
  expires    DateTime

  @@unique([identifier, token])
}

// ─── clubs ─────────────────────────────────────────────────────────────────

model Club {
  id                        String   @id @default(cuid())
  slug                      String   @unique
  name                      String
  description               String?
  logoKey                   String?
  primaryColor              String?
  secondaryColor            String?
  instagramUrl              String?
  tiktokUrl                 String?
  // Where players pay the organizer directly (HU-13): Yape/Plin number, holder and QR image.
  paymentPhone              String?
  paymentHolderName         String?
  paymentQrKey              String?
  // HU-22: optional fee the player pays on Mercado Pago charges; at most one of the two is set.
  serviceFeeFixedCents      Int      @default(0)
  serviceFeePercentBps      Int      @default(0)
  // HU-30: hours before the start until which a player who cancels keeps what they paid as
  // balance in the club; null = no policy (cancelling a paid sign-up loses it).
  cancellationDeadlineHours Int?
  createdAt                 DateTime @default(now())
  updatedAt                 DateTime @updatedAt

  members         ClubMember[]
  invitations     ClubInvitation[]
  communities     Community[]
  events          Event[]
  recurringEvents RecurringEvent[]
  payments        Payment[]
  products        Product[]
  orders          Order[]
  plans           Plan[]
  planPurchases   PlanPurchase[]
  balances        PlayerBalance[]

  mercadoPagoConnection MercadoPagoConnection?
  subscription          Subscription?
}

// Single-use link to set a new password (HU-01). Only the sha256 of the token is stored.
model PasswordResetToken {
  id        String    @id @default(cuid())
  userId    String
  tokenHash String    @unique
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model ClubMember {
  id        String   @id @default(cuid())
  clubId    String
  userId    String
  role      ClubRole
  createdAt DateTime @default(now())

  club Club @relation(fields: [clubId], references: [id], onDelete: Cascade)
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([clubId, userId])
  @@index([userId])
}

// HU-33: single-use link to join a club as admin or helper. Only the sha256 of the token is stored.
model ClubInvitation {
  id              String    @id @default(cuid())
  clubId          String
  role            ClubRole
  tokenHash       String    @unique
  expiresAt       DateTime
  usedAt          DateTime?
  createdByUserId String
  createdAt       DateTime  @default(now())

  club      Club @relation(fields: [clubId], references: [id], onDelete: Cascade)
  createdBy User @relation(fields: [createdByUserId], references: [id], onDelete: Cascade)

  @@index([clubId])
}

model Community {
  id        String   @id @default(cuid())
  clubId    String
  name      String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  club            Club             @relation(fields: [clubId], references: [id], onDelete: Cascade)
  events          Event[]
  recurringEvents RecurringEvent[]

  @@unique([clubId, name])
}

// ─── events ────────────────────────────────────────────────────────────────

model Event {
  id                  String               @id @default(cuid())
  // Duplicated from the community so `events` can filter by club on its own.
  clubId              String
  communityId         String
  title               String
  startsAt            DateTime
  venueName           String
  mapsUrl             String?
  priceCents          Int
  capacity            Int
  isMixed             Boolean              @default(false)
  rules               String?
  status              EventStatus          @default(draft)
  cancelledAt         DateTime?
  // Chosen by the organizer on cancel; tells registered players what happens to their money.
  cancellationOutcome CancellationOutcome?
  // HU-28: set when the event was published from a weekly template. `recurringSlot` is the
  // scheduled start and never changes, so editing or cancelling the date doesn't recreate it.
  recurringEventId    String?
  recurringSlot       DateTime?
  createdAt           DateTime             @default(now())
  updatedAt           DateTime             @updatedAt

  club           Club            @relation(fields: [clubId], references: [id], onDelete: Restrict)
  community      Community       @relation(fields: [communityId], references: [id], onDelete: Restrict)
  recurringEvent RecurringEvent? @relation(fields: [recurringEventId], references: [id], onDelete: Restrict)
  registrations  Registration[]
  pickupOrders   Order[]

  @@unique([recurringEventId, recurringSlot])
  @@index([clubId, startsAt])
  @@index([communityId])
}

// HU-28: weekly template ("todos los martes 8 p. m."). Dates are published `publishDaysBefore`
// days ahead, lazily when the club's pages are opened. Templates aren't edited, only paused.
model RecurringEvent {
  id                String   @id @default(cuid())
  clubId            String
  communityId       String
  title             String
  // 0 = Sunday … 6 = Saturday, in Lima.
  weekday           Int
  // Minutes after 00:00 in Lima.
  startMinute       Int
  venueName         String
  mapsUrl           String?
  priceCents        Int
  capacity          Int
  isMixed           Boolean  @default(false)
  rules             String?
  publishDaysBefore Int
  isPaused          Boolean  @default(false)
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  club      Club      @relation(fields: [clubId], references: [id], onDelete: Restrict)
  community Community @relation(fields: [communityId], references: [id], onDelete: Restrict)
  events    Event[]

  @@index([clubId])
  @@index([communityId])
}

// ─── registrations ─────────────────────────────────────────────────────────

// A guest registration is simply one with userId = null.
model Registration {
  id            String             @id @default(cuid())
  eventId       String
  userId        String?
  firstName     String
  lastName      String
  phone         String
  position      PlayerPosition?
  level         PlayerLevel?
  gender        PlayerGender?
  // HU-31: team assigned when the organizer builds teams (1..8); null = no team yet.
  teamNumber    Int?
  status        RegistrationStatus @default(pending_payment)
  // HU-21: while paying with Mercado Pago the seat is held only until this moment.
  reservedUntil DateTime?
  createdAt     DateTime           @default(now())
  updatedAt     DateTime           @updatedAt

  event      Event       @relation(fields: [eventId], references: [id], onDelete: Restrict)
  user       User?       @relation(fields: [userId], references: [id], onDelete: SetNull)
  payments   Payment[]
  // HU-27: set when the registration was paid with a plan credit.
  creditUse  CreditUse?
  // HU-30: set when it was paid with balance in favor.
  balanceUse BalanceUse?

  // Database-level guard against double registration, even under concurrency.
  @@unique([eventId, phone])
  @@index([eventId, createdAt])
  @@index([phone])
  @@index([userId])
}

// ─── payments ──────────────────────────────────────────────────────────────

// One row per attempt; exactly one of registrationId / orderId / planPurchaseId is set (SQL CHECK).
model Payment {
  id                   String               @id @default(cuid())
  clubId               String
  registrationId       String?
  orderId              String?
  planPurchaseId       String?
  // Total charged, service fee included (HU-22).
  amountCents          Int
  serviceFeeCents      Int                  @default(0)
  method               PaymentMethod
  status               PaymentStatus        @default(pending)
  // Mercado Pago payment id: makes the webhook idempotent.
  providerPaymentId    String?              @unique
  // Private voucher image: bucket key, read only through signed URLs.
  proofFileKey         String?
  yapeSecurityCode     String?
  rejectionReason      String?
  // Mercado Pago's status_detail (cc_rejected_insufficient_amount…), to explain a failure.
  providerStatusDetail String?
  // Set when the event is cancelled (HU-05); a mark only, no money moves through Convoley.
  cancellationOutcome  CancellationOutcome?
  reviewedAt           DateTime?
  reviewedByUserId     String?
  createdAt            DateTime             @default(now())
  updatedAt            DateTime             @updatedAt

  club         Club          @relation(fields: [clubId], references: [id], onDelete: Restrict)
  registration Registration? @relation(fields: [registrationId], references: [id], onDelete: Restrict)
  order        Order?        @relation(fields: [orderId], references: [id], onDelete: Restrict)
  planPurchase PlanPurchase? @relation(fields: [planPurchaseId], references: [id], onDelete: Restrict)
  reviewedBy   User?         @relation("PaymentReviewer", fields: [reviewedByUserId], references: [id], onDelete: SetNull)

  @@index([registrationId])
  @@index([orderId])
  @@index([planPurchaseId])
  @@index([clubId, createdAt])
}

// The organizer's Mercado Pago account, connected by OAuth (HU-18). Players' payments are
// created with this token, so the money goes straight to the organizer: Convoley holds none.
model MercadoPagoConnection {
  id                    String   @id @default(cuid())
  clubId                String   @unique
  mpUserId              String   @unique
  // AES-256-GCM with MP_TOKEN_ENCRYPTION_KEY; never stored in plain text.
  accessTokenEncrypted  String
  refreshTokenEncrypted String
  // Not secret: the browser SDK needs it to tokenize cards and Yape.
  publicKey             String
  expiresAt             DateTime
  liveMode              Boolean
  connectedByUserId     String
  createdAt             DateTime @default(now())
  updatedAt             DateTime @updatedAt

  club Club @relation(fields: [clubId], references: [id], onDelete: Cascade)
}

// ─── store ─────────────────────────────────────────────────────────────────

model Product {
  id          String   @id @default(cuid())
  clubId      String
  name        String
  description String?
  priceCents  Int
  // Up to 5 bucket keys; the limit is a domain rule.
  imageKeys   String[]
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  club     Club             @relation(fields: [clubId], references: [id], onDelete: Restrict)
  variants ProductVariant[]

  @@index([clubId])
}

model ProductVariant {
  id        String  @id @default(cuid())
  productId String
  // null when the product has no sizes.
  size      String?
  stock     Int

  product    Product     @relation(fields: [productId], references: [id], onDelete: Cascade)
  orderItems OrderItem[]

  @@unique([productId, size])
}

model Order {
  id            String      @id @default(cuid())
  clubId        String
  userId        String?
  firstName     String
  lastName      String
  phone         String
  pickupEventId String
  status        OrderStatus @default(pending_payment)
  totalCents    Int
  createdAt     DateTime    @default(now())
  updatedAt     DateTime    @updatedAt

  club        Club        @relation(fields: [clubId], references: [id], onDelete: Restrict)
  user        User?       @relation(fields: [userId], references: [id], onDelete: SetNull)
  pickupEvent Event       @relation(fields: [pickupEventId], references: [id], onDelete: Restrict)
  items       OrderItem[]
  payments    Payment[]

  @@index([clubId, status])
  @@index([userId])
  @@index([pickupEventId])
}

model OrderItem {
  id             String @id @default(cuid())
  orderId        String
  variantId      String
  quantity       Int
  // Price frozen at purchase time.
  unitPriceCents Int

  order   Order          @relation(fields: [orderId], references: [id], onDelete: Cascade)
  variant ProductVariant @relation(fields: [variantId], references: [id], onDelete: Restrict)

  @@index([orderId])
  @@index([variantId])
}

// ─── plans ─────────────────────────────────────────────────────────────────

// A package of dates or a period (HU-26): "4 fechas por S/ 50", "mensualidad". At least one of
// creditCount / validityDays is set (SQL CHECK). Plans aren't edited, only deactivated, so the
// terms never change for players who already bought one.
model Plan {
  id           String   @id @default(cuid())
  clubId       String
  name         String
  priceCents   Int
  // Dates included; null = unlimited during the validity period.
  creditCount  Int?
  // Days the plan lasts from its payment; null = no expiry.
  validityDays Int?
  // Communities whose events accept the plan's credits (ids; a deleted one just never matches).
  communityIds String[]
  isActive     Boolean  @default(true)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  club      Club           @relation(fields: [clubId], references: [id], onDelete: Restrict)
  purchases PlanPurchase[]

  @@index([clubId])
}

// A plan bought by a player (HU-27). It belongs to the buyer's Google account (required to buy;
// nullable only so deleting the account keeps the club's sales history). The plan's terms are read from `Plan`, which never changes once offered.
model PlanPurchase {
  id               String             @id @default(cuid())
  clubId           String
  planId           String
  userId           String?
  firstName        String
  lastName         String
  phone            String
  status           PlanPurchaseStatus @default(pending_payment)
  // null = unlimited dates; set from the plan when it becomes active.
  creditsRemaining Int?
  paidAt           DateTime?
  // null = no expiry; paidAt + validityDays.
  expiresAt        DateTime?
  createdAt        DateTime           @default(now())
  updatedAt        DateTime           @updatedAt

  club       Club        @relation(fields: [clubId], references: [id], onDelete: Restrict)
  plan       Plan        @relation(fields: [planId], references: [id], onDelete: Restrict)
  user       User?       @relation(fields: [userId], references: [id], onDelete: SetNull)
  payments   Payment[]
  creditUses CreditUse[]

  @@index([clubId, phone])
  @@index([userId])
}

// One registration paid with one credit (HU-27); deleted when the credit is given back.
model CreditUse {
  id             String   @id @default(cuid())
  planPurchaseId String
  registrationId String   @unique
  createdAt      DateTime @default(now())

  planPurchase PlanPurchase @relation(fields: [planPurchaseId], references: [id], onDelete: Restrict)
  registration Registration @relation(fields: [registrationId], references: [id], onDelete: Restrict)

  @@index([planPurchaseId])
}

// HU-30: money a player kept in the club by cancelling before the deadline. It is credit to pay
// future sign-ups of this club, never money Convoley holds or returns. Found by phone.
model PlayerBalance {
  id           String   @id @default(cuid())
  clubId       String
  userId       String
  balanceCents Int      @default(0)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  club Club         @relation(fields: [clubId], references: [id], onDelete: Restrict)
  user User         @relation(fields: [userId], references: [id], onDelete: Restrict)
  uses BalanceUse[]

  @@unique([clubId, userId])
}

// One registration paid with balance (HU-30); deleted when the balance is given back.
model BalanceUse {
  id              String   @id @default(cuid())
  playerBalanceId String
  registrationId  String   @unique
  amountCents     Int
  createdAt       DateTime @default(now())

  playerBalance PlayerBalance @relation(fields: [playerBalanceId], references: [id], onDelete: Restrict)
  registration  Registration  @relation(fields: [registrationId], references: [id], onDelete: Restrict)

  @@index([playerBalanceId])
}

// ─── billing ───────────────────────────────────────────────────────────────

// HU-35: the club's Convoley subscription. Access ends at max(trialEndsAt, paidUntil).
model Subscription {
  clubId      String    @id
  trialEndsAt DateTime
  paidUntil   DateTime?
  // HU-36: set by the platform owner; forces read-only even if paid.
  suspendedAt DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  club     Club                  @relation(fields: [clubId], references: [id], onDelete: Cascade)
  payments SubscriptionPayment[]
}

// HU-35: a monthly payment to Convoley, recorded by the platform owner (manual collection).
model SubscriptionPayment {
  id               String   @id @default(cuid())
  clubId           String
  amountCents      Int
  // Access date this payment extended the subscription to.
  paidUntil        DateTime
  recordedByUserId String?
  createdAt        DateTime @default(now())

  subscription Subscription @relation(fields: [clubId], references: [clubId], onDelete: Restrict)
  recordedBy   User?        @relation(fields: [recordedByUserId], references: [id], onDelete: SetNull)

  @@index([clubId, createdAt])
}
